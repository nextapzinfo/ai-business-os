# Database (Neon Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider
ANTHROPIC_API_KEY=""

# WhatsApp (Meta Cloud API — direct integration, no BSP)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_ID="" # Meta App ID — needed only for uploading a template header image (Resumable Upload API)

# Cron protection — Vercel automatically sends this as a Bearer token when it
# calls scheduled routes (see vercel.json "crons"); set the same value here so
# /api/cron/* routes can verify the request actually came from Vercel Cron and
# not a random person hitting the URL (which would trigger real WhatsApp sends).
CRON_SECRET=""

# Google Analytics 4 Data API (2026-08-24, owner's live visitor/website
# analytics dashboard request — see lib/ga4.ts and app/dashboard/visitors).
# From the banglar-doi-analytics Google Cloud project's service account JSON
# key (client_email / private_key fields) — a DIFFERENT service account from
# GOOGLE_SERVICE_ACCOUNT_EMAIL/KEY below (Sheets), deliberately kept separate.
# GA4_PROPERTY_ID is the numeric GA4 property ID (NOT the "G-XXXXXXXXXX"
# Measurement ID) — found in the property's admin URL,
# analytics.google.com/analytics/web/#/a<ACCOUNT_ID>p<PROPERTY_ID>/..., or
# under Admin → Property Settings. Until all 3 of these are set, the Website
# Visitors dashboard page just shows a "not connected yet" message — nothing
# else in the app is affected.
GA4_SERVICE_ACCOUNT_EMAIL=""
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=""
GA4_PROPERTY_ID=""

# Banglar Doi <-> AI Business OS integration (Phase 9 — this app calling
# INTO banglardoi.com for order-status/product-stock; and 2026-08-24's
# reverse direction — banglardoi.com calling INTO
# /api/integrations/banglardoi/customer-event to tag Clients source:
# "WEBSITE"). ONE shared secret, used both ways — this value must be
# identical to banglardoi.com's own INTEGRATION_SHARED_SECRET.
BANGLARDOI_API_BASE_URL="" # banglardoi.com's live URL, e.g. https://banglardoi.com — used for the outbound calls only
BANGLARDOI_INTEGRATION_SECRET=""
