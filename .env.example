# Anthropic one above, get it from platform.openai.com.
OPENAI_API_KEY=""

# WhatsApp (Meta Cloud API — direct integration, no BSP)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
