generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

// Every business table carries organizationId from day 1 (multi-tenant by design)
model Organization {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  whatsappPhoneNumberId  String?  @unique
  vertical               String   @default("RETAIL") // RETAIL, CA, HEALTH, EDUCATION, REAL_ESTATE — drives which dashboard tabs/features show
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Billing page rate assumptions — all editable by the owner, since none of
  // these are numbers we can know for certain. usdToInrRate is a manual
  // conversion (no live forex API, kept simple/reliable). The three template
  // rates default to rough India averages from Meta's public 2025+ per-message
  // pricing; costPerConversation defaults to 0 because Meta moved off
  // conversation-based billing in July 2025 — free-form replies inside the
  // 24-hour window are free — this field only matters if a business's setup
  // still has some conversation-based charge.
  usdToInrRate         Float @default(88)
  costPerMarketingMsg  Float @default(0.010)
  costPerUtilityMsg    Float @default(0.002)
  costPerAuthMsg       Float @default(0.002)

  // Flat shipping charge added to every WhatsApp Catalog cart checkout bill
  // (see Order.shippingCharge below). Editable on the Products page. Simple
  // flat-rate for now — no distance/weight-based calculation.
  shippingCharge       Float @default(0)
  costPerConversation  Float @default(0)

  // Meta Commerce Manager catalog id, connected to this org's WABA — powers
  // native WhatsApp Catalog/Cart messages (Product.retailerId maps each of
  // our products to an entry in this catalog).
  metaCatalogId String?

  users            User[]
  clients          Client[]
  documents        Document[]
  conversations    Conversation[]
  reminders        Reminder[]
  auditLogs        AuditLog[]
  messageTemplates MessageTemplate[]
  broadcasts       Broadcast[]
  products         Product[]
  agentProfile     AgentProfile?
  clientProductInterests ClientProductInterest[]
  events           Event[]
  orders           Order[]
  clientOrders     ClientOrder[]
  conversationInsights ConversationInsight[]
  aiUsageLogs      AiUsageLog[]
  whatsAppCostLogs WhatsAppCostLog[]
  deliveryZones    DeliveryZone[]
  campaigns        Campaign[]
  quickReplies     QuickReply[]
  clientGroups     ClientGroup[]
}

// Configures how the WhatsApp AI presents itself and behaves — replaces the
// old hardcoded "Tax/Law firm" system prompt with per-organization settings,
// editable from the Agent Studio dashboard page.
model AgentProfile {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id])
  businessName         String?
  greetingMessage      String?
  businessDescription  String?
  coreIdentity         String?  // free-text persona/identity paragraph — replaces the auto-generated opening line of the system prompt when set; overall voice/judgment, not narrow rules (those go in customInstructions)
  customInstructions   String?  // free-text rules the owner writes, always injected into the system prompt (not RAG-dependent)
  brandLanguage        String?  // JSON: { wordsToUse: string[], wordsToAvoid: string[], terminology: {from:string,to:string}[] } — brand-specific vocabulary, always injected
  tone                 String   @default("friendly") // friendly, formal, casual
  languageStyle        String   @default("mixed") // bn, en, mixed (Bengali/English/Banglish mix)
  skillOrderConfirm    Boolean  @default(false) // placeholder toggle — order-confirmation automation not yet built
  skillReminders       Boolean  @default(false) // placeholder toggle — auto-reminder automation not yet built
  skillSendQr          Boolean  @default(false) // when true + qrCodeUrl is set, webhook sends the QR on payment-related messages
  qrCodeUrl            String?  // pre-made payment QR image (uploaded once in Agent Studio), sent as-is — never generated
  skillSaveAddress     Boolean  @default(false) // when true, AI can save/update a customer's address via function-calling
  skillTrackInterest   Boolean  @default(false) // when true, AI can note which product a customer is interested in
  skillSendEventPhotos Boolean  @default(false) // when true, webhook sends an Event's photo when a RAG match is close enough
  skillTakeOrders      Boolean  @default(false) // when true, AI can record a customer's order via function-calling (record_order)
  skillFollowUp        Boolean  @default(false) // when true, the daily cron sends followUpTemplateId to customers who haven't replied in followUpHours
  followUpHours        Int      @default(24) // how long to wait with no customer reply before sending the follow-up template
  followUpTemplateId   String?  // MessageTemplate.id to send — loose reference (not a hard FK) so a deleted template doesn't break the profile
  skillSelfAnalysis    Boolean  @default(false) // when true, the nightly cron asks the AI to self-critique each newly-closed conversation
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           Role         @default(STAFF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  phone          String
  email          String?
  address        String? // saved by staff, or by the AI via function-calling when a customer shares it on WhatsApp
  pinCode        String? // PIN / postal code, entered by staff on the Add Client form
  notes          String?
  dateOfBirth    DateTime? // kept in the schema for existing data; no longer collected via the Clients UI
  interestedIn   String? // free-text note from staff at signup time — separate from the AI-tracked productInterests relation below
  tags           String[]     @default([])
  // Where this phone number first came from. "WHATSAPP_DIRECT" = organic
  // contact with no ad/post attribution (the default — set on every
  // webhook-created Client unless a referral is present); "FACEBOOK_AD" /
  // "FACEBOOK_POST" / "INSTAGRAM_AD" / "INSTAGRAM_POST" = customer tapped a
  // Click-to-WhatsApp ad or an organic post's WhatsApp button, detected from
  // WhatsApp's own `message.referral` payload (no separate Meta integration
  // needed); "MANUAL" = added via the Clients page "Add a client" form;
  // "IMPORTED" = added via the Google Sheet bulk import; "WEBSITE" = signed
  // up or ordered on banglardoi.com first (built 2026-08-29 — see
  // websiteOrders below for the actual order data that sync now carries).
  source         String       @default("WHATSAPP_DIRECT")
  sourceDetail   String? // e.g. the ad/post headline or URL from message.referral, when available
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversations        Conversation[]
  reminders            Reminder[]
  broadcastRecipients  BroadcastRecipient[]
  productInterests     ClientProductInterest[]
  orders               Order[]
  groupMemberships     ClientGroupMember[]
  // Real banglardoi.com website orders, pushed in by that repo's
  // notifyAiBusinessOsOrderSync() — deliberately a DIFFERENT relation/model
  // from `orders` (Order[]) above, which is this app's own in-WhatsApp
  // manually-tracked order flow (free-text items, no real line-item data).
  // See ClientOrder below for why these are kept separate.
  websiteOrders        ClientOrder[]

  @@index([organizationId])
}

// A reusable, hand-picked customer segment for Broadcasts — added
// 2026-08-28, owner's own request: "ar akbar select kore ami jdi group banie
// rakhi then next time taderke abar select korte hobe na" (once I've
// selected and saved a group, I shouldn't have to select them again next
// time). Deliberately separate from Client.tags (used as the dynamic
// "category/interest" filter on the same page) — a saved group is a fixed
// snapshot of specific clients picked once (e.g. "Janmashtami campaign
// responders"), while a tag filter always reflects whoever currently has
// that tag. Broadcasts itself doesn't reference this directly; the
// Broadcasts page just uses a saved group to pre-select `clientIds` in the
// existing recipient checkbox list.
model ClientGroup {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  name           String
  createdAt      DateTime            @default(now())
  members        ClientGroupMember[]

  @@index([organizationId])
}

model ClientGroupMember {
  id       String      @id @default(cuid())
  groupId  String
  group    ClientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId String
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([groupId, clientId])
  @@index([groupId])
}

// Uploaded knowledge base source files (GST rules, ITR docs, etc.)
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  fileUrl        String
  content        String? // raw source text (pre-chunking) — kept so the Knowledge tab can show/edit it
  status         String       @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt      DateTime     @default(now())

  chunks  DocumentChunk[]
  product Product? // set when this Document was auto-created from a Product Sheet import
  event   Event? // set when this Document was created from an Event/offer entry

  @@index([organizationId])
}

// RAG: chunked + embedded pieces of each Document, used for similarity search.
// The `embedding` column is written/read via raw SQL ($executeRaw/$queryRaw) since
// Prisma Client can't set or select Unsupported("vector") fields directly.
model DocumentChunk {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content        String
  chunkIndex     Int
  embedding      Unsupported("vector(1024)")?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([documentId])
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  channel        String       @default("WHATSAPP")
  status         String       @default("OPEN") // OPEN, ESCALATED, CLOSED
  aiPaused       Boolean      @default(false) // true once staff "intervenes" — AI stops auto-replying until resumed
  handoffReason  String?      // set by the AI itself (request_human_handoff tool) when it escalates — cleared when staff replies or resumes AI; distinguishes an AI-initiated escalation from a staff manually pausing
  lastFollowUpAt DateTime?    // set when the AI Follow-up cron sends a nudge template — prevents sending more than once
  lastProductId  String?      // last Product this conversation clearly resolved to (RAG match or send_product_photo tool) — lets a context-only "pic ache?" follow-up (no product name repeated) still find the right product. Loose reference, not a hard FK, so a deleted product doesn't break the conversation.
  lastTopicDocumentId String? // last Document (knowledge doc / Event) this conversation clearly resolved to — same loose-reference, "current message first, then memory" pattern as lastProductId above, but for topic/document-level continuity instead of a single product (topic-continuity fix, Aug 2026). Lets a generic follow-up like "kiki ache?" or "ar ki ki pabo?" that repeats no distinctive word still anchor to the document/Event just discussed, instead of falling through to whatever RAG's fuzzy top-5 search happens to guess. Loose reference, not a hard FK, so a deleted document doesn't break the conversation.

  // Lightweight persisted conversation state (business-rules architecture,
  // Aug 2026) — deliberately a handful of typed fields, not a formal state
  // machine. Updated after each turn; used to (a) let the AI carry forward
  // what it already knows without re-deriving it from raw message history
  // every time, and (b) let lib/business-rules.ts resolve delivery/campaign
  // facts without waiting on the customer to repeat their PIN code. None of
  // these are trusted blindly for a business decision — record_order always
  // re-validates against live DeliveryZone/Campaign rows via validateOrderState().
  pincode            String?   // last 6-digit PIN code the customer gave in this conversation (deterministic regex match, or the save_customer_address tool) — kept separate from Client.pinCode (staff-entered on the Add Client form) since this is customer-stated and should be usable immediately, before any staff edit
  deliveryZoneId     String?   // resolved from pincode via resolveDeliveryZone() — loose reference, not a hard FK, so a deleted/renamed zone doesn't break the conversation
  conversationStage  String?   // informational label only, not an enforced transition graph: browsing, collecting_address, order_pending, confirmed — set by simple rules in the webhook, never itself used to gate a business rule
  cartState          Json?     // small in-progress snapshot the model last confirmed: [{ productId, name, qty }] — helps the model stay consistent turn-to-turn; NEVER the source of truth for an order total, which record_order always computes fresh from its own tool-call arguments

  createdAt      DateTime     @default(now())

  messages Message[]
  insight  ConversationInsight?

  @@index([organizationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         String // CLIENT, AI, STAFF
  content        String
  imageUrl       String? // set when this message included a photo OR video (template header image, product/event photo, staff-sent media) — name kept as-is to avoid touching every existing read site; mediaType below says which
  mediaType      String? // IMAGE or VIDEO when imageUrl is set from a staff-sent attachment/Quick Reply; null for the older photo-only paths (they're always images)
  noKnowledgeMatch    Boolean  @default(false) // set on an AI message when the RAG search found zero relevant Knowledge Base chunks — surfaced on the Analytics/Training pages as a knowledge gap
  answeredQuestion    String?  // the customer's question this AI message was answering — set for AI messages, used by Analytics/Training so they don't have to hunt for the preceding message
  flaggedWrong        Boolean  @default(false) // staff marked this AI reply as wrong from the conversation thread
  correctionNote      String?  // staff's corrected answer, written on the Training Dashboard
  correctionStatus    String   @default("PENDING") // PENDING, ADDED_TO_KB, DISMISSED
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// A saved, reusable attachment (photo/video + optional ready-made caption)
// staff can send into a Conversation with one click instead of re-uploading
// the same file from their PC/phone every time — e.g. a price-list photo or
// a standard intro video. Added 2026-08-28, owner's own request: "Conversation
// e pic/video pathate chai, or some pre attachment quick reply hisebe".
model QuickReply {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String // staff-facing label only, e.g. "Price List" — never sent to the customer
  // mediaUrl/mediaType are optional as of 2026-08-28 — owner's own request:
  // "Quick reply te - Only text o without pic add kora jabe" (should be able
  // to add a Quick Reply with just text, no picture). Both null together
  // means this is a text-only Quick Reply; captionText then holds the actual
  // message text sent (same field either way — it was always "the text sent
  // alongside/instead of the media").
  mediaUrl       String? // IMAGE or VIDEO file, or null for a text-only Quick Reply
  mediaType      String? // IMAGE or VIDEO — null exactly when mediaUrl is null
  captionText    String? // sent as the WhatsApp caption alongside the media (or as the whole message, for a text-only Quick Reply); editable per-send before sending
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Reminder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  title          String
  dueDate        DateTime
  status         String       @default("PENDING") // PENDING, SENT, DONE
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Access-log requirement from compliance notes: who viewed/touched which client's data
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// WhatsApp message templates — must be submitted to Meta and approved before
// they can be used to message a customer outside the 24-hour service window.
model MessageTemplate {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String // internal label, e.g. "Eid Offer"
  metaTemplateName String // exact name registered with Meta (lowercase_snake_case)
  metaTemplateId   String? // id Meta assigns after creation, used to poll approval status
  category         String // MARKETING, UTILITY, AUTHENTICATION
  language         String       @default("bn")
  bodyText         String // template text, e.g. "Hi {{1}}, ..." — {{1}} etc are variables
  headerType       String       @default("NONE") // NONE, TEXT, IMAGE
  headerText       String? // static text only (no variables) — max 60 chars, enforced in UI
  headerImageUrl   String? // Vercel Blob URL of the source image — re-uploaded to Meta at template-creation time to get a media handle
  footerText       String? // static text only — max 60 chars
  buttons          String? // JSON array: [{type:"QUICK_REPLY"|"URL"|"PHONE_NUMBER"|"COPY_CODE", text?, url?, phoneNumber?, example?}]
  status           String       @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  broadcasts Broadcast[]

  @@index([organizationId])
}

// A single bulk-send job: one approved template sent to a list of clients.
model Broadcast {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  templateId     String
  template       MessageTemplate @relation(fields: [templateId], references: [id])
  name           String
  status         String          @default("DRAFT") // DRAFT, SENDING, SENT, FAILED
  createdAt      DateTime        @default(now())

  recipients BroadcastRecipient[]

  @@index([organizationId])
}

// Per-client delivery status within a broadcast.
model BroadcastRecipient {
  id           String    @id @default(cuid())
  broadcastId  String
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  status       String    @default("PENDING") // PENDING, SENT, FAILED
  errorMessage String?
  sentAt       DateTime?

  @@index([broadcastId])
}

// Retail-vertical only (see Organization.vertical). One row per product row
// imported from a Google Sheet. Linked 1:1 to a Document so its text (name +
// price + description) feeds the same RAG knowledge base the WhatsApp AI
// already searches — when a matched chunk traces back to a Product with an
// imageUrl, the webhook sends the photo alongside the text answer.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  documentId     String       @unique
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name           String
  price          String? // kept as text — retail price strings vary ("৳500", "500-700", etc.)
  description    String?
  imageUrl       String?
  retailerId     String? // Meta Commerce Manager "Content ID" for this product — links it to the WhatsApp Catalog entry so it can be sent as a native Interactive Product Message (see Catalog/Cart build plan). Not the same as our internal Product.id.
  featured       Boolean      @default(false) // shown in the auto-sent product carousel when a customer asks about products generally (not a specific one) — mark your 3-5 bestsellers
  featuredOrder  Int? // lower number = shown first in the featured carousel (and the AI's matching text list); ties/nulls fall back to creation order
  variantGroup   String? // owner-set label (e.g. "Ghee") grouping pack-size variants of the same item — when a customer asks about a product that has siblings sharing this label, all of them are sent as a carousel instead of one card, so the customer can pick which size to add to cart
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  clientInterests ClientProductInterest[]

  @@index([organizationId])
}

// Tracks which customers have shown interest in which products, noted by the AI
// mid-conversation (or by staff) — one row per client+product pair so repeated
// interest just refreshes the note/timestamp instead of piling up duplicates.
// Surfaced as chips on the Clients page for staff follow-up.
model ClientProductInterest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  note           String? // optional short context from the conversation
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([clientId, productId])
  @@index([organizationId])
  @@index([clientId])
}

// Festival specials, sale announcements, or other event/offer photos the AI can
// surface when relevant. Linked 1:1 to a Document (same pattern as Product) so
// the event's text (title + description + date) feeds the shared RAG knowledge
// base — when a matched chunk traces back to an Event with an imageUrl, the
// webhook sends the photo alongside the text answer.
model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  documentId     String       @unique
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  eventDate      DateTime?
  imageUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// Orders the AI records mid-conversation via the record_order tool (Order
// Assistant skill), or that staff add manually. Prices aren't stored here —
// Product.price is a free-text string ("৳500", "500-700"), so there's no
// reliable way to auto-compute a total; staff confirm the real total when
// they action the order.
model Order {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id])
  items            String // short readable list, e.g. "2kg Mishti Doi, 1kg Ghee" — not a structured cart
  deliveryAddress  String? // snapshot at order time; customer may give a different address than their saved one
  note             String? // any other instruction from the customer (e.g. preferred delivery time)
  status           String       @default("PENDING") // PENDING, CONFIRMED, FULFILLED, CANCELLED
  paymentStatus    String       @default("UNPAID") // UNPAID, PAID — set manually by staff after checking a customer's payment screenshot; no payment gateway wired up yet (see Billing/Razorpay build plan for the future automated path)

  // Only populated for orders placed via native WhatsApp Catalog/Cart checkout
  // (message.type === "order") — Meta hands us exact item prices pulled from
  // the connected Commerce Manager catalog at checkout time, so these are
  // trustworthy numbers even though Product.price itself is free-text.
  // Manually-added orders (the form on the Orders page) leave these null.
  subtotal         Float?
  shippingCharge   Float?
  totalAmount      Float?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@index([clientId])
}

// A real order placed on banglardoi.com (Banglar Doi's own ecommerce site),
// pushed in by that repo's src/lib/ai-business-os-sync.ts
// (notifyAiBusinessOsOrderSync) right after checkout — see
// app/api/integrations/banglardoi/order-sync/route.ts for the receiving
// end. Added 2026-08-29 per the owner's request to see a customer's real
// website order history (items/qty/price, not just a source tag) on their
// Client row.
//
// Deliberately a SEPARATE model from Order above, not a reuse of it — that
// one is this app's own in-WhatsApp order flow: free-text `items`, a
// PENDING/CONFIRMED/FULFILLED/CANCELLED status vocabulary staff set by
// hand, and amounts staff type in themselves. Folding banglardoi.com's real
// structured order data into it would either force a redundant "source"
// column onto every existing WhatsApp order or risk misreading a
// banglardoi.com order's actual PENDING_PAYMENT/CONFIRMED/SHIPPED/DELIVERED
// status against Order's own different vocabulary. Keeping them apart means
// neither model's meaning has to bend to accommodate the other.
model ClientOrder {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // banglardoi.com's own human-readable order number (e.g. "BD-10293") —
  // the natural upsert key so a later sync call for the SAME order (a
  // status change once it ships, say) updates this row in place instead of
  // creating a duplicate. Unique across the whole table, not just per
  // client, matching banglardoi.com's own Order.orderNumber uniqueness.
  orderNumber    String   @unique
  // banglardoi.com's own order status string (PENDING_PAYMENT, CONFIRMED,
  // SHIPPED, DELIVERED, CANCELLED, ...), passed through as-is rather than
  // remapped into this app's unrelated Order.status vocabulary above.
  status         String
  // Grand total in ₹ (banglardoi.com stores/computes in paise internally;
  // converted to rupees before being sent, matching how this app already
  // shows every other ₹ amount — see Order.totalAmount above).
  totalInRupees  Float
  // The order's own placed-at timestamp from banglardoi.com (order.createdAt
  // there) — kept distinct from createdAt/updatedAt below, which instead
  // reflect when THIS ROW was first synced/last updated here.
  placedAt       DateTime
  // Structured line items: [{ productName, variantLabel, quantity,
  // unitPriceInRupees, totalPriceInRupees }] — banglardoi.com's real
  // per-item breakdown, not a free-text summary (contrast with Order.items
  // above). Json rather than a child table since this is always written
  // and read as one whole snapshot per order, never queried per-item.
  itemsJson      Json

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Business Rule Engine data (Aug 2026) — the authoritative source for every
// delivery fee, minimum order, and campaign offer the AI is allowed to quote.
// lib/business-rules.ts reads only from these tables (plus Organization); the
// AI itself never computes or invents a delivery number — see
// docs/ai-business-os-architecture-assessment.md for the full rationale.
// RETAIL-vertical only; unused/empty for other verticals with zero effect.
// ---------------------------------------------------------------------------

// A named delivery area (e.g. "Kolkata & Covered Areas", "Hooghly"), matched
// to a customer's PIN code via ZonePincode. Tiered fees live on DeliveryTier;
// a time-boxed promotional override lives on Campaign.
model DeliveryZone {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // e.g. "Kolkata & Covered Areas", "Hooghly"
  minOrderAmount Float        @default(0) // ₹ — orders below this can't be delivered to this zone at all (0 = no minimum)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pincodes  ZonePincode[]
  tiers     DeliveryTier[]
  campaigns Campaign[]

  @@index([organizationId])
}

// One delivery-fee tier within a zone, e.g. "₹350–599 → ₹100 delivery".
// Tiers within a zone should not overlap. maxAmount = null means "and above"
// (typically the free-delivery tier, feeAmount 0).
model DeliveryTier {
  id             String       @id @default(cuid())
  deliveryZoneId String
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  minAmount      Float // ₹ inclusive lower bound
  maxAmount      Float? // ₹ inclusive upper bound; null = no upper bound
  feeAmount      Float // ₹ delivery charge for orders in this range (0 = free)

  @@index([deliveryZoneId])
}

// One PIN code → one DeliveryZone. A PIN code with no row here has no
// resolvable zone: resolveDeliveryZone() returns null rather than guessing,
// so the AI must ask which area the customer is in rather than quote a number.
model ZonePincode {
  id             String       @id @default(cuid())
  deliveryZoneId String
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  pincode        String

  @@unique([deliveryZoneId, pincode])
  @@index([pincode])
}

// A time-boxed promotional override on top of a zone's normal delivery tiers
// — e.g. "Janmashtami: ₹1,500+ orders in Kolkata/New Town get FREE delivery +
// 500g Laal Kheer Doi free". A campaign only overrides a zone's own rules for
// orders that meet its own minOrderAmount within its own date range and zone
// restriction; if nothing matches, the zone's normal tiers apply unchanged.
model Campaign {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id])
  deliveryZoneId      String? // null = applies across all of this org's zones; set = restricted to one zone (e.g. Kolkata only)
  deliveryZone        DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  name                String // e.g. "Janmashtami 2026"
  isActive            Boolean       @default(true)
  startsAt            DateTime
  endsAt              DateTime
  minOrderAmount      Float         @default(0) // ₹ — order must be at least this to qualify for the campaign offer
  freeDelivery        Boolean       @default(false)
  freeGiftDescription String? // e.g. "500g Laal Kheer Doi" — shown to the customer as-is
  freeGiftProductId   String? // loose reference to Product (same convention as Conversation.lastProductId), not a hard FK
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([organizationId])
}

// One row per CLOSED conversation, written once by the nightly self-analysis
// cron (not per-chat — that would mean an extra OpenAI call every single
// conversation, which gets expensive fast). The AI reviews its own transcript
// and self-critiques; this is only ever a SUGGESTION for the owner to review
// on the Training Dashboard — nothing here is auto-applied to the Knowledge
// Base or Custom Instructions on its own.
model ConversationInsight {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  conversationId     String       @unique
  conversation       Conversation @relation(fields: [conversationId], references: [id])
  mistakes           String? // what the AI thinks it got wrong, in its own words
  unanswered         String? // questions it couldn't answer
  suggestedKnowledge String? // what it thinks should be added to the Knowledge Base
  suggestedRules     String? // a new Custom Instruction rule it thinks might help
  status             String       @default("PENDING") // PENDING (needs owner review), REVIEWED
  createdAt          DateTime     @default(now())

  @@index([organizationId])
}

// One row per real OpenAI API call (webhook replies, sandbox tests, nightly
// self-analysis) — cost is computed at write time from ACTUAL tokens returned
// by OpenAI, using the published gpt-4o-mini per-token rate. This is exact,
// not an estimate, unlike WhatsAppCostLog below.
model AiUsageLog {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  source           String // webhook_reply, sandbox_test, self_analysis, teach_ai_chat
  promptTokens     Int
  completionTokens Int
  costUsd          Float
  createdAt        DateTime     @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

// One row per WhatsApp template/conversation send that has a real cost —
// costUsd is an ESTIMATE using the organization's configured per-message rate
// (Meta's actual charge depends on the recipient's country and can change;
// the true number always lives in Meta's own Billing dashboard). Logged from
// Broadcasts, single Send Template, and the AI Follow-up cron.
model WhatsAppCostLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  kind           String // TEMPLATE, CONVERSATION
  category       String? // MARKETING, UTILITY, AUTHENTICATION — set when kind = TEMPLATE
  costUsd        Float
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([createdAt])
}
