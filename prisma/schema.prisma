generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

// Every business table carries organizationId from day 1 (multi-tenant by design)
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  documents     Document[]
  conversations Conversation[]
  reminders     Reminder[]
  auditLogs     AuditLog[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           Role         @default(STAFF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  phone          String
  email          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversations Conversation[]
  reminders     Reminder[]

  @@index([organizationId])
}

// Uploaded knowledge base source files (GST rules, ITR docs, etc.)
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  fileUrl        String
  status         String       @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  channel        String       @default("WHATSAPP")
  status         String       @default("OPEN") // OPEN, ESCALATED, CLOSED
  createdAt      DateTime     @default(now())

  messages Message[]

  @@index([organizationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         String // CLIENT, AI, STAFF
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Reminder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  title          String
  dueDate        DateTime
  status         String       @default("PENDING") // PENDING, SENT, DONE
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Access-log requirement from compliance notes: who viewed/touched which client's data
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
